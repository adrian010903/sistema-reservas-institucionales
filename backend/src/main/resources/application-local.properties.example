# Copia este archivo como application-local.properties y completa tus valores locales.
spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_MYSQL
app.jwt.secret=CAMBIA_ESTA_CLAVE_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
# Solo para pruebas locales. En producción el token debe enviarse por correo y permanecer oculto.
app.recovery.expose-token=true
# Tarifa demostrativa por hora en colones; cámbiala cuando se defina el precio institucional.
app.reservas.tarifa-hora=25000
# Separa varios orígenes con coma, sin barra final.
app.cors.allowed-origins=http://localhost:5173
# Correo opcional. Mantén false hasta contar con un SMTP institucional.
app.frontend.url=http://localhost:5173
app.mail.enabled=false
app.mail.from=no-reply@ejemplo.cr
spring.mail.host=smtp.ejemplo.cr
spring.mail.port=587
spring.mail.username=TU_USUARIO_SMTP
spring.mail.password=TU_PASSWORD_SMTP
